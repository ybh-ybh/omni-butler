# 本地开发直连 PostgreSQL；Docker 部署请使用 deploy/.env.example。
DATABASE_URL=postgresql://omni_butler:change-me@127.0.0.1:5432/omni_butler?schema=public

# 客户端首次连接所需同步密钥：至少 16 个字符。
SYNC_SECRET=replace-with-a-long-random-sync-secret

# 本地开发使用独立同步端口；同域名 HTTPS 部署可改用统一公网根地址。
# 启用 PUBLIC_BASE_URL 时删除或注释下面的 POWERSYNC_URL，避免独立地址优先。
# PUBLIC_BASE_URL=https://butler.example.com
POWERSYNC_URL=http://127.0.0.1:8080

# API 固定监听 3000；RSA 密钥自动保存到 .local/keys。

# 图片和笔记原音共用内网MinIO；原音独立私有桶，不受图片同步开关影响。
# 本地开发修改端点与私有凭证文件路径；Docker默认读取部署生成的只读凭证。
MINIO_ENDPOINT=http://minio:9000
MINIO_CREDENTIALS_FILE=/app/image-storage/credentials.json
# none 保留文本/录音/同步，tencent 开启经过用户授权的云端转写。
NOTE_ASR_PROVIDER=none
NOTE_ASR_MODEL=16k_zh
# 超过5MB的长录音要求腾讯可访问的HTTPS API根地址。
# PUBLIC_BASE_URL 自动派生该地址；独立非空覆盖优先，未配置时小文件内联提交。
# NOTE_ASR_PUBLIC_URL=https://api.example.com/omni-butler/api/v1
# APP_ID 是部署信息；API3.0 使用 SecretId/SecretKey 签名，不向客户端下发。
TENCENT_ASR_APP_ID=
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
