# PostgreSQL（建议为 Omni Butler 单独创建数据库与低权限账号）
DATABASE_URL=postgresql://omni_butler:change-me@127.0.0.1:5432/omni_butler?schema=public

# 服务基础配置
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://127.0.0.1:4173

# 设备首次连接所需同步密钥，至少16字符
SYNC_SECRET=replace-with-a-long-random-sync-secret

# 本地开发同样自动生成并持久化RSA密钥；两项手工密钥可选
JWT_KEYS_DIR=.local/keys
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_KEY_ID=omni-butler-2026-01
JWT_ISSUER=https://api.example.com
JWT_AUDIENCE=omni-butler-api
POWERSYNC_AUDIENCE=omni-butler-powersync
REFRESH_TOKEN_TTL_SECONDS=2592000

# 自托管 PowerSync 对外 HTTPS 地址
POWERSYNC_URL=https://sync.example.com
