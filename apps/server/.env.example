# PostgreSQL（建议为 Omni Butler 单独创建数据库与低权限账号）
DATABASE_URL=postgresql://omni_butler:change-me@127.0.0.1:5432/omni_butler?schema=public

# 服务基础配置
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://127.0.0.1:4173

# 首次启动时创建的唯一管理员账号；创建后请从服务器环境删除明文密码
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-at-least-12-characters

# 执行 npm run keys:generate 后，将生成结果复制到这里
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_KEY_ID=omni-butler-2026-01
JWT_ISSUER=https://api.example.com
JWT_AUDIENCE=omni-butler-api
POWERSYNC_AUDIENCE=omni-butler-powersync
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_SECONDS=2592000

# 自托管 PowerSync 对外 HTTPS 地址
POWERSYNC_URL=https://sync.example.com

# 腾讯云 COS：永久密钥只保存在服务端，建议使用仅具备目标桶权限的 CAM 子账号
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_COS_BUCKET=example-1250000000
TENCENT_COS_REGION=ap-guangzhou
COS_STS_DURATION_SECONDS=1800
COS_MAX_UPLOAD_BYTES=20971520
