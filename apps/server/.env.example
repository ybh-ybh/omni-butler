# 本地开发直连 PostgreSQL；Docker 部署请使用 deploy/.env.example。
DATABASE_URL=postgresql://omni_butler:change-me@127.0.0.1:5432/omni_butler?schema=public

# 客户端首次连接所需同步密钥：至少 16 个字符。
SYNC_SECRET=replace-with-a-long-random-sync-secret

# 客户端能够访问的 PowerSync 地址。
POWERSYNC_URL=http://127.0.0.1:8080

# API 固定监听 3000；RSA 密钥自动保存到 .local/keys。
