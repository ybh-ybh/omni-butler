generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// 快照替换回执不关联 owner，避免后续重建删除幂等证据。
model SyncMigrationReceipt {
  migrationId String @id @map("migration_id") @db.Uuid
  expectedOwnerId String @map("expected_owner_id") @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  payloadHash String @map("payload_hash") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("sync_migration_receipts")
}

/// 单人部署的数据归属标识，不是登录账号。
model SyncOwner {
  id                   String                @id @default(uuid()) @db.Uuid
  sessions             DeviceSession[]
  receipts             SyncReceipt[]
  /// 供在线业务入口安全重放的服务端回执，不参与业务同步。
  businessReceipts     BusinessOperationReceipt[]
  /// MCP 专用授权与审批只存在服务端。
  mcpConnections       McpConnection[]
  /// 已准备及已执行的 MCP 业务动作。
  mcpActions           McpAction[]
  tombstones           SyncTombstone[]
  todoItems            TodoItem[]
  /// 后台重复待办的服务端状态与逐系列进度，不参与同步。
  todoRecurrenceState TodoRecurrenceState?
  todoRecurrenceCursors TodoRecurrenceCursor[]
  /// 后台实例的持续同步保护，不随连接撤销或记录删除清理。
  todoRecurrenceProtections TodoRecurrenceProtection[]
  /// 进度任务的独立步骤。
  todoProgressSteps    TodoProgressStep[]
  quotes               Quote[]
  dailyQuoteSelections DailyQuoteSelection[]
  /// 旧设备日签身份到当前日历槽位的映射。
  dailyQuoteSelectionAliases DailyQuoteSelectionAlias[]
  taxonomyEntries      TaxonomyEntry[]
  recordTaxonomyLinks  RecordTaxonomyLink[]
  events               Event[]
  eventCompletions     EventCompletion[]
  inventoryItems       InventoryItem[]
  timeEntries          TimeEntry[]
  memberships          Membership[]
  membershipPayments   MembershipPayment[]
  images               BusinessImage[]
  imageReceipts        ImageOperationReceipt[]
  /// 笔记正文、历史版本、音频与持久识别任务。
  noteEntries          NoteEntry[]
  noteVersions         NoteVersion[]
  noteAudioSegments    NoteAudioSegment[]
  /// 每张笔记图片独立同步，文件沿用 BusinessImage 私有对象存储。
  noteImages           NoteImage[]
  noteAudioAssets      NoteAudioAsset[]
  noteRecognitionJobs  NoteRecognitionJob[]
  /// 模型密钥与整理任务只存后端，不进入业务同步。
  aiSettings AiSettings?
  aiProfiles AiProfile[]
  notePolishJobs NotePolishJob[]
  /// 应用内助手私有状态，不参与业务同步。
  assistantSettings AssistantSettings?
  assistantConversations AssistantConversation[]
  assistantTasks AssistantTask[]
  assistantRuns AssistantRun[]
  assistantMessages AssistantMessage[]
  assistantEvents AssistantEvent[]
  assistantMemories AssistantMemory[]
  assistantAttempts AssistantAttempt[]

  @@map("sync_owners")
}

/// 本地优先笔记；正文版本身份用于检测并发编辑。
model NoteEntry {
  id String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  body String @default("")
  dayKey String @map("day_key") @db.VarChar(10)
  /// 记录自然日内的秒数；旧记录为空时由创建事实稳定推导。
  recordTimeSeconds Int? @map("record_time_seconds")
  /// 设定记录时间时的 UTC 偏移分钟数，与日期和秒数整体同步。
  recordUtcOffsetMinutes Int? @map("record_utc_offset_minutes")
  /// 独立同步的笔记置顶元数据，旧记录默认不置顶。
  isPinned Boolean @default(false) @map("is_pinned")
  /// 创建时区名称与当时UTC偏移，旧行明确标记为未知而不伪造地区。
  creationTimezone String @default("legacy:unknown") @map("creation_timezone") @db.VarChar(128)
  tags String @default("[]")
  revision String @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  user SyncOwner @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions NoteVersion[]
  audioSegments NoteAudioSegment[]
  images NoteImage[]
  @@unique([userId, id])
  @@index([userId, dayKey])
  @@map("note_entries")
}

/// 笔记多图的独立身份与排序，文件元数据通过图片服务同步。
model NoteImage {
  id String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  noteId String @map("note_id") @db.Uuid
  sortOrder Int @map("sort_order")
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  user SyncOwner @relation(fields: [userId], references: [id], onDelete: Cascade)
  note NoteEntry @relation(fields: [userId, noteId], references: [userId, id], onDelete: Cascade)
  @@index([userId, noteId, sortOrder])
  @@map("note_images")
}

/// 不可变正文候选；base_revision 不匹配时也完整保留。
model NoteVersion {
  id String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  noteId String @map("note_id") @db.Uuid
  body String
  baseRevision String @map("base_revision") @db.Uuid
  revision String @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  user SyncOwner @relation(fields: [userId], references: [id], onDelete: Cascade)
  note NoteEntry @relation(fields: [userId, noteId], references: [userId, id], onDelete: Cascade)
  @@unique([userId, noteId, revision])
  @@index([userId, noteId])
  @@map("note_versions")
}

/// 音频事实同步；存储路径和服务商任务身份仅留在后端私有表。
model NoteAudioSegment {
  id String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  noteId String @map("note_id") @db.Uuid
  sortOrder Int @map("sort_order")
  durationMs Int @map("duration_ms")
  mime String @db.VarChar(32)
  sha256 String @db.VarChar(64)
  byteSize Int @map("byte_size")
  transcript String?
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  user SyncOwner @relation(fields: [userId], references: [id], onDelete: Cascade)
  note NoteEntry @relation(fields: [userId, noteId], references: [userId, id], onDelete: Cascade)
  asset NoteAudioAsset?
  recognitionJobs NoteRecognitionJob[]
  polishJobs NotePolishJob[]
  @@unique([userId, id])
  @@index([userId, noteId, sortOrder])
  @@map("note_audio_segments")
}

/// 经摘要校验的不可变原音文件归属。
model NoteAudioAsset {
  segmentId String @id @map("segment_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  objectKey String @unique @map("object_key")
  user SyncOwner @relation(fields: [userId], references: [id], onDelete: Cascade)
  segment NoteAudioSegment @relation(fields: [userId, segmentId], references: [userId, id], onDelete: Cascade)
  @@unique([userId, segmentId])
  @@map("note_audio_assets")
}

/// 持久任务与提交不确定状态防止断网或进程重启重复计费。
model NoteRecognitionJob {
  id String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  segmentId String @map("segment_id") @db.Uuid
  provider String @db.VarChar(32)
  model String @db.VarChar(64)
  status String @db.VarChar(32)
  providerTaskId String? @map("provider_task_id") @db.VarChar(64)
  transcript String?
  errorCode String? @map("error_code") @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  nextPollAt DateTime @default(now()) @map("next_poll_at") @db.Timestamptz(3)
  user SyncOwner @relation(fields: [userId], references: [id], onDelete: Cascade)
  segment NoteAudioSegment @relation(fields: [userId, segmentId], references: [userId, id], onDelete: Cascade)
  polishJobs NotePolishJob[]
  @@index([userId, segmentId, createdAt])
  @@index([status, nextPollAt])
  @@map("note_recognition_jobs")
}

/// 后端共享设置通过总版本号避免多设备静默覆盖。
model AiSettings {
  userId String @id @map("user_id") @db.Uuid
  revision Int @default(0)
  activeProfileId String? @map("active_profile_id") @db.Uuid
  notePolishEnabled Boolean @default(false) @map("note_polish_enabled")
  user SyncOwner @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("ai_settings")
}

/// 供应商配置和加密密钥，不参与 PowerSync。
model AiProfile {
  id String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  name String @db.VarChar(80)
  provider String @db.VarChar(16)
  baseUrl String @map("base_url") @db.VarChar(2048)
  model String @db.VarChar(128)
  encryptedApiKey String? @map("encrypted_api_key")
  revision Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user SyncOwner @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@map("ai_profiles")
}

/// 每次整理尝试固定配置和原文摘要，未知提交只允许用户显式重试。
model NotePolishJob {
  id String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  segmentId String @map("segment_id") @db.Uuid
  recognitionId String @map("recognition_id") @db.Uuid
  /// 归属锁内递增，避免同毫秒重试排序被 UUID 随机性影响。
  attempt Int @default(0)
  enabled Boolean
  status String @db.VarChar(32)
  profileId String? @map("profile_id") @db.Uuid
  profileRevision Int? @map("profile_revision")
  provider String? @db.VarChar(16)
  baseUrl String? @map("base_url")
  model String? @db.VarChar(128)
  encryptedApiKey String? @map("encrypted_api_key")
  promptVersion Int @default(1) @map("prompt_version")
  sourceHash String? @map("source_hash") @db.VarChar(64)
  text String?
  errorCode String? @map("error_code") @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user SyncOwner @relation(fields: [userId], references: [id], onDelete: Cascade)
  segment NoteAudioSegment @relation(fields: [userId, segmentId], references: [userId, id], onDelete: Cascade)
  recognition NoteRecognitionJob @relation(fields: [recognitionId], references: [id], onDelete: Cascade)
  @@index([userId, segmentId, recognitionId, createdAt], map: "note_polish_jobs_recognition_lookup_idx")
  @@index([status, createdAt])
  @@unique([recognitionId, attempt])
  @@map("note_polish_jobs")
}

/// 独立于归属和记录生命周期的文件清理回执。
model NoteAudioGarbage {
  objectKey String @id @map("object_key")
  dueAt DateTime @default(now()) @map("due_at") @db.Timestamptz(3)
  @@map("note_audio_garbage")
}

/// 与迁移身份绑定的原音暂存，只有完整校验后的快照才能接管。
model NoteAudioStaging {
  migrationId String @map("migration_id") @db.Uuid
  segmentId String @map("segment_id") @db.Uuid
  sha256 String @db.VarChar(64)
  byteSize Int @map("byte_size")
  mime String @db.VarChar(32)
  objectKey String @unique @map("object_key")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@id([migrationId, segmentId])
  @@map("note_audio_staging")
}

/// 图片关联与显式移除标记通过独立接口同步，不进入 PowerSync 业务白名单。
model BusinessImage {
  userId String @map("user_id") @db.Uuid
  businessType String @map("business_type") @db.VarChar(32)
  businessId String @map("business_id") @db.Uuid
  attachmentId String? @map("attachment_id") @db.Uuid
  revision String @db.Uuid
  objectKey String? @map("object_key")
  sha256 String? @db.VarChar(64)
  mimeType String? @map("mime_type") @db.VarChar(32)
  sizeBytes Int? @map("size_bytes")
  user SyncOwner @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, businessType, businessId])
  @@unique([objectKey])
  @@map("business_images")
}

/// 操作回执与图片修改同事务保存，避免重试覆盖后来的图片。
model ImageOperationReceipt {
  userId String @map("user_id") @db.Uuid
  operationId String @map("operation_id") @db.Uuid
  payloadHash String @map("payload_hash") @db.VarChar(64)
  result Json
  user SyncOwner @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, operationId])
  @@map("image_operation_receipts")
}

/// 对象清理任务不关联 owner，重建服务器后仍可清理旧对象。
model ImageObjectGarbage {
  objectKey String @id @map("object_key")
  dueAt DateTime @map("due_at") @db.Timestamptz(3)
  @@index([dueAt])
  @@map("image_object_garbage")
}

/// 高熵设备会话凭证只保存摘要；会话删除即撤销。
model DeviceSession {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  user      SyncOwner @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("device_sessions")
}

/// 在线业务动作的执行结果；不与离线同步事务身份混用。
model BusinessOperationReceipt {
  /// 数据归属及调用执行层固定操作身份。
  userId String @map("user_id") @db.Uuid
  /// 调用执行层固定的业务操作身份。
  operationId String @map("operation_id") @db.Uuid
  /// 业务动作和负载摘要防止身份被不同请求挪用。
  action String @db.VarChar(80)
  /// 原始业务请求的规范化摘要。
  payloadHash String @map("payload_hash") @db.VarChar(64)
  /// 与副作用同时提交的脱敏业务结果。
  result Json
  /// 回执随实际业务提交建立。
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 归属被显式替换时，旧回执随之清理。
  user SyncOwner @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, operationId])
  @@map("business_operation_receipts")
}

/// 专用 Bearer 令牌仅存摘要，独立于设备凭据。
model McpConnection {
  /// 服务端固定连接身份。
  id String @id @db.Uuid
  /// 数据归属。
  userId String @map("user_id") @db.Uuid
  /// 用户可辨认的连接名称。
  name String @db.VarChar(100)
  /// 随机令牌的 SHA256 摘要。
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  /// 只用于复用领域身份校验的独立会话，不向 MCP 交付其凭据。
  sessionId String @map("session_id") @db.Uuid
  /// 显式模块读权限。
  readModules String[] @map("read_modules")
  /// 显式模块写权限，授权后可提交固定业务动作。
  writeModules String[] @map("write_modules")
  /// 用户明确配置的默认时区，空值不猜测。
  timeZone String? @map("time_zone")
  /// 空值表示永久连接，仍可随时撤销。
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)
  /// 撤销时刻。
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// 创建时间。
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 删除归属即撤销授权。
  user SyncOwner @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 持久动作保留来源连接。
  actions McpAction[]
  @@map("mcp_connections")
}

/// 固定预览和执行结果不进入 PowerSync 业务表，旧审批字段只供历史兼容。
model McpAction {
  /// 同时用于领域幂等身份派生。
  id String @id @db.Uuid
  /// 数据归属。
  userId String @map("user_id") @db.Uuid
  /// 发起连接。
  connectionId String? @map("connection_id") @db.Uuid
  /// 来源隔离外部连接与设备认证助手任务。
  source String @default("mcp") @db.VarChar(16)
  sourceId String @map("source_id") @db.Uuid
  /// 调用方重试保持的请求身份。
  requestId String @map("request_id") @db.Uuid
  /// 工具及输入摘要，防止挪用身份。
  inputHash String @map("input_hash") @db.VarChar(64)
  /// 经过服务端校验并固定绝对日期的业务步骤。
  steps Json
  /// 业务对象基线摘要。
  baseline String @db.VarChar(64)
  /// 冻结的前后事实与关联影响。
  preview Json
  /// 固定预览摘要，沿用旧审批字段名，不再作为人工授权凭据。
  approvalHash String @map("approval_hash") @db.VarChar(64)
  /// pending/succeeded/cancelled/expired/conflict；approved仅为旧流程历史状态。
  status String @default("pending") @db.VarChar(20)
  /// 旧人工审批设备身份，新动作不填写。
  approvedBy String? @map("approved_by") @db.Uuid
  /// 旧人工审批时刻，新动作不填写。
  approvedAt DateTime? @map("approved_at") @db.Timestamptz(3)
  /// 和业务副作用同事务保存的结果。
  result Json?
  /// 冻结的操作有效期。
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  /// 创建时间。
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 最后状态转换时间。
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// 归属删除后旧动作不可恢复授权。
  user SyncOwner @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 原连接撤销后动作仍保留审计事实。
  connection McpConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  @@unique([connectionId, requestId])
  @@unique([source, sourceId, requestId])
  @@index([userId, createdAt])
  @@map("mcp_actions")
}

/// 助手独立选择已有模型，不覆盖笔记整理设置。
model AssistantSettings {
  userId String @id @map("user_id") @db.Uuid
  revision Int @default(0)
  enabled Boolean @default(false)
  profileId String? @map("profile_id") @db.Uuid
  memoryReadEnabled Boolean @default(true) @map("memory_read_enabled")
  memoryWriteEnabled Boolean @default(true) @map("memory_write_enabled")
  memoryVersion Int @default(0) @map("memory_version")
  timeZone String @default("Asia/Shanghai") @map("time_zone") @db.VarChar(128)
  user SyncOwner @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("assistant_settings")
}

/// 会话删除清除聊天正文，业务回执独立保留。
model AssistantConversation {
  id String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  title String @db.VarChar(100)
  summary String @default("")
  summaryThrough DateTime? @map("summary_through") @db.Timestamptz(3)
  memoryVersion Int @default(0) @map("memory_version")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user SyncOwner @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, updatedAt])
  @@map("assistant_conversations")
}

/// 整项用户任务跨模型轮次与澄清保持同一身份。
model AssistantTask {
  id String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid
  sessionId String @map("session_id") @db.Uuid
  runId String @map("run_id") @db.Uuid
  status String @default("queued") @db.VarChar(32)
  planVersion Int @default(0) @map("plan_version")
  plan Json?
  approvedHash String? @map("approved_hash") @db.VarChar(64)
  actionId String? @map("action_id") @db.Uuid
  /// 准备请求身份与真实动作身份分开，崩溃后安全重放。
  planRequestId String? @map("plan_request_id") @db.Uuid
  committed Boolean @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user SyncOwner @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, conversationId, status])
  @@map("assistant_tasks")
}

/// 可接管的执行尝试；密文配置快照不进入事件或图状态。
model AssistantRun {
  id String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid
  taskId String @map("task_id") @db.Uuid
  sessionId String @map("session_id") @db.Uuid
  status String @default("queued") @db.VarChar(32)
  profileSnapshot Json @map("profile_snapshot")
  state Json
  leaseOwner String? @map("lease_owner") @db.Uuid
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(3)
  eventSequence Int @default(0) @map("event_sequence")
