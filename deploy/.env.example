# 首次部署复制为 .env，Compose 会自动读取以下配置。
# 数据库密码：使用较长的随机字母数字串，避免连接 URL 中的特殊字符。
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# 客户端首次连接所需同步密钥：至少 16 个字符。
SYNC_SECRET=replace-with-a-long-random-sync-secret

# API 的宿主机映射端口，容器内部端口固定为 3000。
API_HOST_PORT=3000

# PowerSync 的宿主机映射端口，容器内部端口固定为 8080。
# 同机 Nginx 代理时，两项可分别填写 127.0.0.1:3000、127.0.0.1:8080。
POWERSYNC_HOST_PORT=8080

# 同域名 HTTPS 部署只需填写公网根地址，可带端口，不包含服务路径。
# 后端自动生成 /omni-butler/powersync/ 与 /omni-butler/api/v1 两个地址。
# 替换为实际域名；长录音识别要求腾讯能够访问这个 HTTPS 地址。
PUBLIC_BASE_URL=https://butler.example.com

# MCP额外允许的代理/LAN Origin，逗号分隔，不填时使用上面的公网Origin及本机回环。
# 例如可信局域网：http://192.168.1.20:3000；公网请使用HTTPS，不允许通配符或路径。
MCP_ALLOWED_ORIGINS=

# 高级覆盖：非空独立地址优先于基础地址；空值会使用自动推导。
# 局域网不同端口直连：注释上面的 PUBLIC_BASE_URL，再填写实际同步地址。
# POWERSYNC_HOST_PORT 只控制端口映射，不会自动修改对外 URL。
# POWERSYNC_PUBLIC_URL=http://192.168.1.10:8080
# 独立公网地址覆盖需保留各自的固定服务前缀。
# POWERSYNC_PUBLIC_URL=https://sync.example.com/omni-butler/powersync/
# NOTE_ASR_PUBLIC_URL=https://api.example.com/omni-butler/api/v1

# 是否同步物品和会员图片；MinIO 始终为笔记原音运行，false 只关闭图片业务。
IMAGE_SYNC_ENABLED=false
# 助手文件附件，独立私有桶，与业务图片开关无关。
ASSISTANT_ATTACHMENTS_ENABLED=false

# 笔记云端转写：密钥只保存在服务端环境，原音位于 MinIO 私有音频桶。
# none 关闭云端转写但保留录音与同步；tencent 启用腾讯语音转文字，需配置 SecretId 和 SecretKey。
NOTE_ASR_PROVIDER=none
NOTE_ASR_MODEL=16k_zh
# 助手实时语音还要求数字 APPID；三项凭据与文件 ASR 共用且仅保留在服务端。
TENCENT_ASR_APP_ID=
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
