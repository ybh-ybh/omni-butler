# PostgreSQL 与设备同步密钥；首次部署前必须替换
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
SYNC_SECRET=replace-with-a-long-random-sync-secret

# 公网与容器内地址
# 局域网部署可填写 http://服务器IP:8080；公网部署必须放在 HTTPS 反向代理后
POWERSYNC_PUBLIC_URL=http://192.168.1.10:8080
PS_JWKS_URL=http://api:3000/api/v1/auth/jwks
PS_PORT=8080
PS_ADMIN_TOKEN=replace-with-random-admin-token
POWERSYNC_AUDIENCE=omni-butler-powersync

# NestJS 基础配置
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=https://app.example.com

# RSA JWT
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_KEY_ID=omni-butler-2026-01
JWT_ISSUER=https://api.example.com
JWT_AUDIENCE=omni-butler-api
REFRESH_TOKEN_TTL_SECONDS=2592000
